DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drivxis?schema=public"
# URL directa sin proxy/Accelerate. Prisma CLI la usa para migraciones en produccion.
DIRECT_DATABASE_URL=""
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE="drivxis_session"

STORAGE_ENDPOINT="https://example-account.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="drivxis-videos"
STORAGE_ACCESS_KEY_ID="replace-me"
STORAGE_SECRET_ACCESS_KEY="replace-me"
STORAGE_PUBLIC_BASE_URL=""

GOOGLE_TRANSLATE_API_KEY=""

# Correo de recuperación de contraseña (Resend)
RESEND_API_KEY=""
EMAIL_FROM="DRIVXIS <acceso@tu-dominio.com>"

LOCAL_STORAGE_ROOT=".drivxis/uploads"
ANALYSIS_STORAGE_ROOT=".drivxis/analysis"
PYTHON_BIN="python"
ANALYSIS_WORKER_INTERVAL_MS="5000"
ANALYSIS_AUTO_START="false"
ANALYSIS_WORKER_MODE="local"
ANALYSIS_SANDBOX_SNAPSHOT_ID=""
ANALYSIS_SANDBOX_TIMEOUT_MS="2700000"
ANALYSIS_SANDBOX_VCPUS="4"
ANALYSIS_SANDBOX_REPOSITORY_DIR="DRIVXIS-Plataforma-de-analisis-de-futbol"
ANALYSIS_SANDBOX_GIT_BRANCH="main"
ANALYSIS_SANDBOX_MODEL_PATH="/home/ubuntu/models/best.onnx"
ANALYSIS_SANDBOX_PYTHON_BIN=".venv-analysis/bin/python"
# Secreto de 32+ caracteres usado solo por Vercel para firmar el apagado del Sandbox.
ANALYSIS_SANDBOX_CALLBACK_SECRET=""
# Opcional en Vercel; se deriva automaticamente del dominio del despliegue.
ANALYSIS_SANDBOX_CALLBACK_URL=""
ANALYSIS_DETECTOR="yolo"
ANALYSIS_MODEL_PATH="analysis/models/best.onnx"
ANALYSIS_MODEL_OBJECT_KEY="models/best.onnx"
ANALYSIS_MODEL_URL=""
ANALYSIS_DETECTION_FPS="5"
ANALYSIS_BATCH_SIZE="4"
ANALYSIS_REQUIRED_GPU_NAME=""
ANALYSIS_MAX_WIDTH="1280"
YOLO_DEVICE="cpu"
YOLO_IMAGE_SIZE="640"
YOLO_PROCESS_EVERY_FRAME="true"
YOLO_FALLBACK_IMAGE_SIZE="1280"
YOLO_SPARSE_PLAYER_THRESHOLD="8"
YOLO_SPARSE_PLAYER_MAX_HEIGHT_RATIO="0.22"
YOLO_CONFIDENCE="0.1"
ANALYSIS_HEARTBEAT_INTERVAL_MS="60000"
ANALYSIS_CANCEL_POLL_MS="1000"
ANALYSIS_STALE_JOB_MINUTES="30"

LOCATEANYTHING_MODEL_ID="nvidia/LocateAnything-3B"
