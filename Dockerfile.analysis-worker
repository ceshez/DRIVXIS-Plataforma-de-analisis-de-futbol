FROM node:22-bookworm-slim AS node-dependencies

WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --omit=dev && npx prisma generate


FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHON_BIN=python \
    ANALYSIS_AUTO_START=false \
    ANALYSIS_DETECTOR=yolo \
    ANALYSIS_MODEL_PATH=/models/best.onnx \
    ANALYSIS_DETECTION_FPS=5 \
    ANALYSIS_BATCH_SIZE=4 \
    ANALYSIS_MAX_WIDTH=1280 \
    LOCAL_STORAGE_ROOT=/work/uploads \
    ANALYSIS_STORAGE_ROOT=/work/analysis \
    ANALYSIS_CANCEL_POLL_MS=1000 \
    ANALYSIS_HEARTBEAT_INTERVAL_MS=60000 \
    ANALYSIS_STALE_JOB_MINUTES=30

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg libglib2.0-0 libgl1 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-dependencies /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY --from=node-dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY scripts ./scripts
COPY analysis ./analysis

RUN python -m pip install --upgrade pip \
    && python -m pip install -r analysis/requirements.txt

RUN groupadd --gid 10001 drivxis \
    && useradd --uid 10001 --gid drivxis --create-home drivxis \
    && mkdir -p /work/uploads /work/analysis /models \
    && chown -R drivxis:drivxis /app /work /models

USER drivxis

VOLUME ["/work", "/models"]

HEALTHCHECK --interval=30s --timeout=15s --start-period=5m --retries=3 \
    CMD test -f /tmp/drivxis-analysis-ready || exit 1

ENTRYPOINT ["bash", "scripts/start-analysis-worker.sh"]
