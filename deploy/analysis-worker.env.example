# Copia este archivo como deploy/analysis-worker.env en el host del worker.
# Nunca confirmes el archivo real con secretos.
DATABASE_URL=""
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

ANALYSIS_DETECTOR="yolo"
ANALYSIS_MODEL_PATH="/models/best.onnx"
# Usa una de las dos fuentes. La clave R2 recomendada es models/best.onnx.
ANALYSIS_MODEL_OBJECT_KEY="models/best.onnx"
ANALYSIS_MODEL_URL=""
ANALYSIS_DETECTION_FPS="5"
ANALYSIS_BATCH_SIZE="4"
ANALYSIS_MAX_WIDTH="1280"
YOLO_DEVICE="cpu"
YOLO_IMAGE_SIZE="640"
YOLO_CONFIDENCE="0.1"
ANALYSIS_CANCEL_POLL_MS="1000"
ANALYSIS_HEARTBEAT_INTERVAL_MS="60000"
ANALYSIS_STALE_JOB_MINUTES="30"
