# Variables de Production para el proyecto Vercel `drivxis`.
# Copia los valores desde tu .env local al dashboard de Vercel; no confirmes secretos.

# Runtime web/API. La URL con pool o Prisma Accelerate es la recomendada aqui.
DATABASE_URL=""
NEXTAUTH_SECRET=""

# Cloudflare R2 / storage S3-compatible. Obligatorio en produccion.
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# Email y traduccion. Deja vacio solo si la funcion correspondiente no se usara.
RESEND_API_KEY=""
EMAIL_FROM="DRIVXIS <acceso@tu-dominio.com>"
GOOGLE_TRANSLATE_API_KEY=""

# El analisis nunca se ejecuta dentro de Vercel.
ANALYSIS_AUTO_START="false"
