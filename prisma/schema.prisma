generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VideoStatus {
  UPLOADED
  PENDING_ANALYSIS
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum TeamMemberRole {
  OWNER
  ADMIN
  ANALYST
  COACH
  VIEWER
}

enum PlayerStatus {
  ACTIVE
  INJURED
  INACTIVE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarObjectKey String?
  avatarMimeType  String?
  role         Role     @default(USER)
  storageLimitBytes BigInt @default(1073741824)
  storageUsedBytes  BigInt @default(0)
  videos       Video[]
  ownedTeams Team[] @relation("TeamOwner")
  teamMemberships TeamMember[]
  createdTeamInvitations TeamInvitation[] @relation("InvitationCreator")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id        String   @id @default(cuid())
  name      String
  season    String?
  ownerId   String
  owner     User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  players   Player[]
  invitations TeamInvitation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(VIEWER)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id          String         @id @default(cuid())
  teamId      String
  email       String
  role        TeamMemberRole @default(VIEWER)
  invitedById String
  team        Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation("InvitationCreator", fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  expiresAt   DateTime

  @@unique([teamId, email])
  @@index([email])
}

model Player {
  id          String       @id @default(cuid())
  teamId      String
  name        String
  position    String
  shirtNumber Int?
  birthDate   DateTime?
  status      PlayerStatus @default(ACTIVE)
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([teamId, shirtNumber])
  @@index([teamId, name])
}

model Video {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  objectKey        String           @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  durationSeconds  Int?
  status           VideoStatus      @default(UPLOADED)
  metadata         Json?
  analysisJobs     AnalysisJob[]
  metricSnapshots  MetricSnapshot[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([ownerId, createdAt])
  @@index([status])
}

model AnalysisJob {
  id        String         @id @default(cuid())
  videoId   String
  video     Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status    AnalysisStatus @default(QUEUED)
  progress  Int            @default(0)
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([videoId])
  @@index([status])
}

model MetricSnapshot {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  jobId     String?
  metrics   Json
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model TranslationCache {
  id             String   @id @default(cuid())
  locale         String
  sourceHash     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([locale, sourceHash])
  @@index([locale])
}
