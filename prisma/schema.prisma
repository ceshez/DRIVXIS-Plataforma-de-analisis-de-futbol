generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum VideoStatus {
  UPLOADED
  PENDING_ANALYSIS
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ChatMode {
  GENERAL
  TACTICAL
  PHYSICAL
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ChatMessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum ChatAttachmentStatus {
  READY
  FAILED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String
  passwordHash       String
  avatarObjectKey    String?
  avatarMimeType     String?
  role               Role                @default(USER)
  locale             String              @default("es")
  theme              String              @default("dark")
  sessionVersion     Int                 @default(0)
  storageLimitBytes  BigInt              @default(1073741824)
  storageUsedBytes   BigInt              @default(0)
  videos             Video[]
  chatThreads        ChatThread[]
  chatAttachments    ChatAttachment[]
  passwordResetCodes PasswordResetCode[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Video {
  id               String             @id @default(cuid())
  ownerId          String
  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  objectKey        String             @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  durationSeconds  Int?
  playedAt         DateTime?
  competition      String?
  status           VideoStatus        @default(UPLOADED)
  metadata         Json?
  analysisJobs     AnalysisJob[]
  metricSnapshots  MetricSnapshot[]
  chatMessageLinks ChatMessageVideo[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([ownerId, createdAt])
  @@index([status])
}

model AnalysisJob {
  id        String         @id @default(cuid())
  videoId   String
  video     Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status    AnalysisStatus @default(QUEUED)
  progress  Int            @default(0)
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([videoId])
  @@index([status])
}

model MetricSnapshot {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  jobId     String?
  metrics   Json
  createdAt DateTime @default(now())

  @@index([videoId, createdAt])
}

model ChatThread {
  id            String           @id @default(cuid())
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title         String           @default("Nuevo chat")
  mode          ChatMode         @default(TACTICAL)
  messages      ChatMessage[]
  attachments   ChatAttachment[]
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([ownerId, lastMessageAt])
}

model ChatMessage {
  id          String             @id @default(cuid())
  threadId    String
  thread      ChatThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role        ChatRole
  status      ChatMessageStatus  @default(COMPLETED)
  mode        ChatMode
  content     String
  command     String?
  errorCode   String?
  metadata    Json?
  videoLinks  ChatMessageVideo[]
  attachments ChatAttachment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([threadId, createdAt])
}

model ChatMessageVideo {
  messageId String
  videoId   String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  video     Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([messageId, videoId])
  @@index([videoId])
}

model ChatAttachment {
  id               String               @id @default(cuid())
  ownerId          String
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  threadId         String
  thread           ChatThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId        String?
  message          ChatMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  objectKey        String               @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt
  status           ChatAttachmentStatus @default(READY)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([ownerId, createdAt])
  @@index([threadId, createdAt])
  @@index([messageId])
}

model TranslationCache {
  id             String   @id @default(cuid())
  locale         String
  sourceHash     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([locale, sourceHash])
  @@index([locale])
}
